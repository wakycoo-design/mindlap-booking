# Copy to .env (local) or set these in your host's environment settings
# (Zoho Catalyst AppSail: Console > AppSail > your app > Configuration > Environment Variables).
# Never commit real values.

# Postgres connection string. For Neon, copy the "pooled" connection string. If your host's console rejects
# the "?sslmode=..." part, leave it off: TLS is switched on automatically for Neon hosts.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional: set to true to force TLS for a non-Neon host whose URL has no sslmode.
# DATABASE_SSL=true
# Optional: keep idle database connections for 5 minutes (set automatically on Catalyst AppSail). Leave off on serverless hosts.
# DATABASE_KEEP_ALIVE=true
# Optional: Neon's direct (non "-pooler") connection string. Used only for migrations when set.
DATABASE_URL_UNPOOLED=

# Random secret for signing staff sessions. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Google OAuth client for staff login (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: https://<your-app-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Zoho login for staff on Zoho Mail (set Google, Zoho or both). Create a "Server-based Application" at
# https://api-console.zoho.in with redirect URI https://<your-app-domain>/api/auth/callback/zoho
AUTH_ZOHO_ID=
AUTH_ZOHO_SECRET=
# Optional: your Zoho data centre's accounts URL. Default https://accounts.zoho.in (India).
# AUTH_ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Google Calendar sync (staff connect their own calendar from their availability page). Create an OAuth client in
# Google Cloud Console, enable the Google Calendar API, and add the redirect URI
# https://<your-app-domain>/api/calendar/google/callback. Leave blank to reuse AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional: key for encrypting stored calendar tokens. Without it AUTH_SECRET is used, and changing AUTH_SECRET
# then disconnects every calendar. Generate with: openssl rand -hex 32
CALENDAR_ENCRYPTION_KEY=

# Optional, local development only: lets staff sign in with their email and this shared password instead of
# Google or Zoho. Ignored in production builds.
# LOCAL_LOGIN_PASSWORD=

# Public URL of the app, e.g. https://booking-xxxx.development.catalystappsail.in
AUTH_URL=

# Optional: websites allowed to call the keyless public booking API (/api/public/v1) from the browser,
# comma-separated, e.g. https://thewaky.com,https://www.thewaky.com. Leave empty to keep it off.
PUBLIC_API_ORIGINS=

# Optional: set to `on` when staff sign in only with personal passwords (no Google or Zoho login).
PASSWORD_LOGIN=

# Emails (comma-separated) that become admins the first time they sign in.
ADMIN_EMAILS=

# Optional: only allow Google accounts on this domain, e.g. yourfirm.com
ALLOWED_EMAIL_DOMAIN=

# Set to true to apply database migrations when the container starts.
RUN_MIGRATIONS=true

# WhatsApp Cloud API, used by WhatsApp workflows
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# OTP codes over WhatsApp (admin sidebar > OTP). The code is sent with an approved WhatsApp "Authentication" template.
# The URL is Meta's messages endpoint for your number: https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>/messages
# Until all three are set, sending a code answers 503 and the request shows as "Send failed" in the OTP report.
# OTP_META_API_URL=
# OTP_META_TOKEN=
# OTP_TEMPLATE_NAME=
# OTP_TEMPLATE_LANGUAGE=en

# Workflows (Settings > Workflows). Each channel is optional: until its settings exist, messages are logged
# as "Not sent" with the text they would have had, so you can try workflows before connecting anything.
# Email over SMTP, e.g. Zoho Mail: smtp.zoho.in, port 465 (or 587), your mailbox and an app password.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Your Firm <bookings@yourfirm.com>"
# Optional: where replies go (for example the front desk), when EMAIL_FROM is a no-reply style address.
# EMAIL_REPLY_TO=frontdesk@yourfirm.com
# Signs custom (webhook) workflow requests with an X-Signature header. Generate with: openssl rand -hex 32
# WORKFLOW_WEBHOOK_SECRET=
# Set to off to stop this container's built-in worker (when another host runs it).
# WORKFLOW_RUNNER=
# Lets a scheduler call POST /api/internal/workflows/run with "Authorization: Bearer <this>". Route is closed if empty.
# CRON_SECRET=

# WORKFLOW_INTERVAL_SEC=30   # how often the built-in worker runs (min 10); raise it to let a scale-to-zero database sleep
