{
  "name": "booking-app",
  "version": "1.0.0",
  "description": "Booking app for the firm: staff dashboard plus a REST API for the website",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:migrate",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --target=node22 --outfile=dist/migrate.cjs --external:pg-native",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "api-key:create": "tsx scripts/create-api-key.ts",
    "staff:set-password": "tsx scripts/set-password.ts",
    "workflow:install": "tsx scripts/install-preset.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}
